<Application x:Class="SmartX.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            
            <Color x:Key="InkColor">#12161C</Color>
            <Color x:Key="InkMutedColor">#5A6472</Color>
            <Color x:Key="PaperColor">#FBF9F5</Color>
            <Color x:Key="PaperEdgeColor">#E7E2D8</Color>
          
            <Color x:Key="SignalOkColor">#3F8F5B</Color>
            <Color x:Key="SignalWarnColor">#C97A18</Color>
            <Color x:Key="SignalErrColor">#B23A3A</Color>
            <Color x:Key="SignalInfoColor">#2F5D8C</Color>

            <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="InkMuted" Color="{StaticResource InkMutedColor}"/>
            <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}"/>
            <SolidColorBrush x:Key="PaperEdge" Color="{StaticResource PaperEdgeColor}"/>

            <SolidColorBrush x:Key="SignalOk" Color="{StaticResource SignalOkColor}"/>
            <SolidColorBrush x:Key="SignalWarn" Color="{StaticResource SignalWarnColor}"/>
            <SolidColorBrush x:Key="SignalErr" Color="{StaticResource SignalErrColor}"/>
            <SolidColorBrush x:Key="SignalInfo" Color="{StaticResource SignalInfoColor}"/>
         
            <FontFamily x:Key="FontDisplay">Georgia, 'Iowan Old Style', serif</FontFamily>
            <FontFamily x:Key="FontBody">'Segoe UI Variable Text', 'Inter', sans-serif</FontFamily>
            <FontFamily x:Key="FontMono">'Cascadia Mono', 'JetBrains Mono', Consolas, monospace</FontFamily> 
            
            <CornerRadius x:Key="RadiusSm">3</CornerRadius>
            <CornerRadius x:Key="RadiusMd">6</CornerRadius>

        </ResourceDictionary>
    </Application.Resources>
</Application>
